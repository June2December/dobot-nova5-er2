  <version>0.1.0</version>
  <description>RealSense D405 RGB-D cup detection and 6D pose estimation</description>
  <maintainer email="june@todo.todo">june</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
