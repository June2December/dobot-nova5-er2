Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: CupPose
      Topic:
        Value: /perception/cup_pose
        Depth: 5
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.005
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: CupMarker
      Topic:
        Value: /perception/cup_marker
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Debug
      Topic:
        Value: /perception/debug_image
        Depth: 5
      Value: true
  Global Options:
    Fixed Frame: camera_color_optical_frame
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Name: Current View
      Pitch: 0.4
      Target Frame: camera_color_optical_frame
      Yaw: 0.6
Window Geometry:
  Height: 800
  Width: 1280
